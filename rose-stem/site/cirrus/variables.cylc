{% do LOG.debug("Entered site/cirrus/variables.cylc") %}

{% do site_vars.update({"known_applications": ["lfric_atm", "gungho_model",
                                               "mesh"]}) %}

{% do site_vars.update({"site_platforms": ["ex"]}) %}

{% do site_vars.update({"scripts_platform": "ex"}) %}

{% do site_vars.update({"mesh_build": {"ex": "gnu_fast-debug-64bit"} }) %}


{% if HPC_QUEUE is defined %}
    {% do site_vars.update({"hpc_queue": HPC_QUEUE}) %}
{% else %}
    {% do site_vars.update({"hpc_queue": "standard"}) %}
{% endif %}

{% include "site/cirrus/common/default_directives.cylc" %}

{% do LOG.debug("Finished in site/cirrus/variables.cylc") %}