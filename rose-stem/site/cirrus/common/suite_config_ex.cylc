{% do LOG.debug("Entered site/cirrus/common/suite_config_ex.cylc") %}

{% set ex_base = 'umask 0022 ; '~
                   'source . ; ' %}

{% set ex_compiler_gnu = 'module load spack_gnu' %}
{# see if we need this at some point #}

    [[EX_BASE]]
        platform = login
        [[[environment]]]
            BUILD_ROOT = ${CYLC_TASK_WORK_DIR}/${CYLC_WORKFLOW_NAME_BASE}_${USER}
            HYPERTHREADS    = 1
            CORES_PER_NODE  = 288
            NUMA_REGIONS_PER_NODE = 8
            LUSTRE_FILESYSTEM = true

    [[EX_SLURM]]
        inherit = EX_BASE
        platform = ex
        [[[environment]]]
            ROSE_LAUNCHER = srun
        [[[directives]]]
            --account={{ HPC_ACCOUNT }}
            --chdir=/work/z19/z19/lparisi/nfs-testing/met-lfric-cirrus/build_lfric/v3/cylc_dev

    [[EX_BUILD]]
        [[[environment]]]
            PSYCLONE_TRANSFORMATION="meto-ex1a"

    [[EX_GNU]]
        pre-script = """
                     umask 0022
                     module use /work/z19/z19/lparisi/nfs-testing/met-lfric-cirrus/environments/lfric/modules/Core
                     module load PrgEnv-gnu
                     module load lfric-meta-gcc-xios2/3.2
                     module load cray-hdf5-parallel
                     module load cray-netcdf-hdf5parallel

                     """
        [[[environment]]]
             COMPILER = 'gnu'

    [[EX_CCE]]
        pre-script = """
                     umask 0022
                    
                     """
        [[[environment]]]
             COMPILER = 'cce'

    [[EX_BUILD_GNU]]
        inherit = EX_SLURM, EX_BUILD, EX_GNU

    [[EX_BUILD_CCE]]
        inherit = EX_SLURM, EX_BUILD, EX_CCE

    [[EX_RUN]]
        [[[environment]]]
            BIG_DATA_DIR   = '/work/z19/z19/shared/lfric/data'
            SMALL_DATA_DIR = '/work/z19/z19/shared/lfric/data'
            TARGET_PLATFORM = 'ex'
            RUN_METHOD = srun

    [[EX_MESH]]
        inherit = EX_SLURM

    [[EX_MESH_GNU]]
        inherit = EX_MESH, EX_GNU
        [[[environment]]]
            ROSE_APP_COMMAND_KEY = srun

    [[EX_MESH_CCE]]
        inherit = EX_MESH, EX_CCE
        [[[environment]]]
            ROSE_APP_COMMAND_KEY = srun

    [[EX_EXPORT-SOURCE]]
        inherit = CIRRUS_ORIG
        [[[environment]]]
            PLATFORM_SYNC = false
        
    [[EX_RUN_GNU]]
       inherit = EX_SLURM, EX_RUN, EX_GNU

    [[EX_RUN_CCE]]
       inherit = EX_SLURM, EX_RUN, EX_CCE

    [[EX_TECH_BASE]]
        inherit = EX_SLURM

    [[EX_PLOT]]
        inherit = EX_TECH_BASE

    [[EX_CHECK]]
        inherit = EX_BASE

    [[EX_HOUSEKEEPING]]

{% do LOG.debug("Finished in site/cirrus/common/suite_config_ex.cylc") %}