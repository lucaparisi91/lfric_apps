        "resolution": "C224_MG",
        "DT": 720,
        "tsteps": 10,
        "mpi_parts": 588,
        "xios_nodes": 1,
        "mpi_parts_xios" : 64,
        "log_level": "info",
        "xios_info_level": 1,
        "xios_print_file": ".true.",
        "memory_plot_ex": false,
    }) %}

